# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local owner accounts and session secret
/.menucraft-data/

# typescript
*.tsbuildinfo
next-env.d.ts

# The dacli workspace lives on its own ref (dacli-record), not on trunk: records
# carried on a branch fork with it, so a task closed on a task branch is
# invisible on trunk until its record merges. The history is NOT lost —
#   git log dacli-record
#   git show dacli-record:.dacli/projects/<p>/tasks/done/<file>
.dacli/
